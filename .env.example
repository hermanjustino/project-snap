# --- Google Gemini (AI Studio) ---
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# --- Vonage Video API ---
# Create an app at https://developer.vonage.com/en/vonage-video/overview
# (Video API app -> download the private.key file into this project root)
VONAGE_APPLICATION_ID=your_vonage_application_id
VONAGE_PRIVATE_KEY_PATH=./private.key

# --- Serper.dev (Google Images search, for the globe's fashion-week popups) ---
# Get a free key at https://serper.dev (2,500 free credits on signup)
SERPER_API_KEY=your_serper_api_key_here

# --- Server ---
PORT=3000

# --- Google Cloud (only needed if you move off the AI Studio key to Vertex AI,
# or deploy to Cloud Run — see GCP.md) ---
GOOGLE_CLOUD_PROJECT=project-snap-e9fe4f
